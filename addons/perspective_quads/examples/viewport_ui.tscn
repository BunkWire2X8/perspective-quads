script/source = "extends Control

func _ready() -> void:
	var confirmation_dialog := ConfirmationDialog.new()
	add_child(confirmation_dialog)
	confirmation_dialog.get_label().text = \"This is a pop-up test.\"
	confirmation_dialog.popup_centered()
"

